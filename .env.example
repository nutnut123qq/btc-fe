# Server-only destination used by Next rewrites. Docker should override this.
BACKEND_INTERNAL_URL=http://127.0.0.1:5197

# Set only for standalone/Docker builds. Local build/start leaves this unset.
NEXT_STANDALONE=0

# Shared proof sent as x-btc-ingress so the backend trusts the forwarded client
# IP. Must match the backend's Ingress:SharedSecret. Leave empty in local dev.
INGRESS_SHARED_SECRET=
